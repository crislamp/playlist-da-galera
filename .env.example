# Copie este arquivo para ".env" e preencha com as suas chaves.
# (o .env NÃO vai pro git — está no .gitignore)

# --- Spotify (Developer Dashboard) ---
# Client ID do seu app. Com PKCE não precisa de client secret.
VITE_SPOTIFY_CLIENT_ID=cole_aqui_o_client_id

# --- Supabase (Project Settings > API) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole_aqui_a_anon_public_key

# Slug real da Edge Function que lê playlists. Ao criar pelo painel, o Supabase
# pode gerar um nome aleatório (ex: "swift-responder") — cole o slug da URL aqui.
VITE_RESOLVE_FN=resolve-spotify-playlist

# --- YouTube (Google Cloud → OAuth Client ID) ---
# Pra criar a playlist de clipes no YouTube. Opcional (só se usar o destino YouTube).
VITE_GOOGLE_CLIENT_ID=cole_aqui_o_google_client_id
